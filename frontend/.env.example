# Django, for the /api and /media rewrites and for server components
BACKEND_URL=http://127.0.0.1:8000
# Same values as in backend/.env: proxy.ts reads the session from these cookies
AUTH_ACCESS_COOKIE=lumora_access
AUTH_REFRESH_COOKIE=lumora_refresh
# The live Neon Crash feed. It goes straight to Django: it is public, so it needs no cookies.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/crash
NEXT_PUBLIC_ROULETTE_WS_URL=ws://127.0.0.1:8000/ws/roulette
# The live football scores (public, no cookies): the matches in play
NEXT_PUBLIC_SPORTS_WS_URL=ws://127.0.0.1:8000/ws/sports
