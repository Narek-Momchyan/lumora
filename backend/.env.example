# Copy this file to .env and fill in the values. Never commit .env.

# Make a real one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend addresses allowed to call the API from the browser (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Origins allowed to send POST, PUT, PATCH and DELETE with a CSRF token (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The site's address: image URLs in API responses start with it
PUBLIC_BASE_URL=http://localhost:3000

# JWT cookies. AUTH_COOKIE_SECURE defaults to True when DEBUG=False.
AUTH_ACCESS_COOKIE=lumora_access
AUTH_REFRESH_COOKIE=lumora_refresh
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# AUTH_COOKIE_SECURE=True

# PostgreSQL (README: "Create the database" shows how to make this user and database)
DB_NAME=lumora
DB_USER=lumora
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (Memurai on Windows): carries the live Neon Crash feed to the WebSocket clients
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/0

# Football data (design/sports-spec.md). A free token from https://www.football-data.org/client/register;
# without one `sync_football` and `run_sports` refuse to start, the rest of the site works.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_URL=https://api.football-data.org/v4
SPORTS_SYNC_INTERVAL_MINUTES=5

# Production only (used when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
