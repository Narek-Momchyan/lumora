# Copy this file to .env and fill in the values. Never commit .env.

# Make a real one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend addresses allowed to call the API from the browser (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (README: "Create the database" shows how to make this user and database)
DB_NAME=lumora
DB_USER=lumora
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Production only (used when DEBUG=False)
# CSRF_TRUSTED_ORIGINS=https://admin.example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
